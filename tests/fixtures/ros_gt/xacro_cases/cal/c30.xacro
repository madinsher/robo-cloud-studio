<?xml version="1.0"?>
<robot name="r" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="dyn" params="a"><d a="${a}"/></xacro:macro><xacro:call macro="dyn" a="3"/><xacro:property name="rm" value="1"/><xacro:property name="rm" remove="true"/><xacro:property name="df" default="7"/><xacro:property name="df" default="8"/><v df="${df}"/>
</robot>
