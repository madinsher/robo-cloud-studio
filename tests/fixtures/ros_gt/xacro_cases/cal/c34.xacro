<?xml version="1.0"?>
<robot name="r" xmlns:xacro="http://www.ros.org/wiki/xacro">
<v b="${'%s' % [1, 'a']}" c="${'%s %s' % (1.0, True)}" e="${str(['a', 1.0, None])}" f="${str(dict(k='v', n=2))}" g="${(1,)}" h="${round(3.14159, 2)}" i="${round(-0.5)}" j="${round(1.5)}" k="${python.abs(-2.0)}" l="${min([3, 1, 2])}" m="${sum([1, 2.5])}" n="${int(True)}" o="${float('inf')}" p="${-float('inf')}" q="${atan2(1, 1)}" r="${sqrt(2)}" s="${pow(2, 3)}" t="${fabs(-3)}" u="${degrees(pi)}" w="${log(e)}" x="${hypot(3, 4)}" y="${copysign(1, -2)}" z="${trunc(-2.5)}"/>
</robot>
