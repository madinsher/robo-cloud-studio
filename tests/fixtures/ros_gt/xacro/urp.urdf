                <mesh filename="package://urp_description/meshes/manipulator/Link_1.STL" />
            </geometry>
        </collision>-->
    </link>
    <joint name="Joint_1" type="revolute">
        <origin xyz="0 0 0" rpy="1.5708 0.020229 0" />
        <parent link="manipulator_base" />
        <child link="Link_1" />
        <axis xyz="0 0 1" />
        <limit lower="-6.28" upper="6.28" effort="150.0" velocity="3.15" />
    </joint>
    <link name="Link_2">
        
    <inertial>
      <mass value="0.29"/>
      <inertia ixx="0.0007464659129791666" ixy="0" ixz="0" iyy="0.0007464659129791666" iyz="0" izz="0.001110943342625"/>
    </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
