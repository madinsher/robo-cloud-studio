        <origin xyz="0 0 0.052" rpy="0 -0.024533 0" />
        <parent link="Link_1" />
        <child link="Link_2" />
        <axis xyz="0 1 0" />
        <limit lower="-0.31" upper="1.63" effort="150.0" velocity="3.15" />
    </joint>
