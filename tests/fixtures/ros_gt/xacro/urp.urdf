<?xml version="1.0"?>
<robot name="urp">
    <link name="base_link">
      <visual>
        <origin rpy="1.57 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/base.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/base.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <origin rpy="1.57 0 0" xyz="0 0 0"/>
      </collision>
    <inertial>
      <origin xyz="0 0 -0.005"/>
      <mass value="2.788"/>
      <inertia ixx="0.0065806093333333334" ixy="0" ixz="0" iyy="0.015488269333333332" iyz="0" izz="0.022022411999999995"/>
    </inertial>
    </link>
    
    <link name="front_right_wheel">
      <visual>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/wheel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/wheel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    <inertial>
      <mass value="0.29"/>
      <inertia ixx="0.0007464659129791666" ixy="0" ixz="0" iyy="0.0007464659129791666" iyz="0" izz="0.001110943342625"/>
    </inertial>
    </link>  
  
    <link name="front_left_wheel">
      <visual>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/wheel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/wheel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    <inertial>
      <mass value="0.29"/>
      <inertia ixx="0.0007464659129791666" ixy="0" ixz="0" iyy="0.0007464659129791666" iyz="0" izz="0.001110943342625"/>
    </inertial>
    </link>  

    <link name="front_right_wheel_rot">
    <visual>
        <origin rpy="-1.57 -1.57 0" xyz="0 -0.088 0.06"/>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/fl.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
      <collision>
      <origin rpy="-1.57 -1.57 0" xyz="0 -0.088 0.06"/>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/fl.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    </link>  

    <link name="front_left_wheel_rot">
    <visual>
    <origin rpy="1.57 -1.57 0" xyz="0 0.088 0.06"/>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/fl.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
      <collision>
      <origin rpy="1.57 -1.57 0" xyz="0 0.088 0.06"/>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/fl.stl" scale="0.01 0.01 0.01"/>
        </geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    </link>  
        
    <link name="back_right_wheel">
      <visual>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/wheel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://urp_description/meshes/vehicle/wheel.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    <inertial>
      <mass value="0.29"/>
      <inertia ixx="0.0007464659129791666" ixy="0" ixz="0" iyy="0.0007464659129791666" iyz="0" izz="0.001110943342625"/>
    </inertial>
    </link>  

    <link name="back_left_wheel">
