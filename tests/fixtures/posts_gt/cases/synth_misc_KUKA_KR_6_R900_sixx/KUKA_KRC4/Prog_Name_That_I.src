WAIT SEC 1.500
Wait for StrClear($LOOP_MSG[])
$LOOP_CONT = TRUE
$LOOP_MSG[] = "Say "hi" to the operator"
; A long comment line that exceeds the usual controller limits for comments by far, really
$OUT[12]=FALSE
OUT_A=TRUE
START_TIMER:
$TIMER_STOP[1]=TRUE
$TIMER_FLAG[1]=FALSE
