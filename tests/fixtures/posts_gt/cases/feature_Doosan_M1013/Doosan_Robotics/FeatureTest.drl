  # def Gripper_Open():
  #   set_digital_output(3, 1)
  #
  # def Gripper_Close():
  #   set_digital_output(3, 0)
  #
  # Example to drive a spray gun:
  def SprayOn(value):
    # use the value as an output:
    DO_SPRAY = 5
    if value == 0:
      set_digital_output(DO_SPRAY, 0)
    else:
      set_digital_output(DO_SPRAY, 1)

  #--------------------------
  
  
  # Main program:
  # Program generated by VerticalBot Studio for Doosan M1013 on 25/10/2026 12:00:00
  # Using nominal kinematics.
  set_ref_coord(set_user_cart_coord(posx(100.000,-50.000,20.000,0.0000,0.0000,30.0000),ref=DR_BASE))
  # TCP: posx(10.000,0.000,120.000,0.0000,15.0000,0.0000)
  set_tcp("Tool 1")
  set_velx(300.000)
  set_velj(90.000)
  set_accx(1500.000)
  set_accj(400.000)
  begin_blend(radius=5.000)
  movej(posj(10.000000,20.000000,90.000000,30.000000,45.000000,60.000000))
  movel(posx(787.952,-25.969,269.993,49.6927,138.6744,135.3838))
  movec(posx(731.709,-71.792,275.735,46.7067,139.1404,136.7292),posx(731.589,-226.843,284.908,34.7045,138.1924,134.0628))
  set_velx(50.000)
  begin_blend(radius=0.000)
  movel(posx(787.952,-25.969,269.993,49.6927,138.6744,135.3838))
  end_blend()
  set_velx(300.000)
  movel(posx(731.709,-71.792,275.735,46.7067,139.1404,136.7292))
  set_digital_output(3, 1)
  DO_GRIP = 0
  wait_digital_input(5,1):
  wait_digital_input(DI_PART,1,2.000):
  wait(0.500)
  # a comment line
  tp_popup("Hello operator", DR_PM_MESSAGE)
  MyFunc()
  SetRPM(5000)
  RAW_CODE_LINE
  SubPick()
  set_velj(45.000)
  # TCP: posx(10.000,0.000,120.000,0.0000,15.0000,0.0000)
  set_tcp("Tool 1")
  # Attach to Tool 1
  movej(posj(10.000000,20.000000,90.000000,30.000000,45.000000,60.000000))
