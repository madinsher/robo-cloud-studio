  end
  sleep(0.500)
  # a comment line
  popup("Hello operator","Message",False,False,blocking=False)
  MyFunc()
  SetRPM(5000)
  RAW_CODE_LINE
  SubPick()
  speed_rads  = 0.785
  set_tcp(p[0.010000, 0.000000, 0.120000, 0.000000, 0.261799, 0.000000])
  # Attach to Tool 1
