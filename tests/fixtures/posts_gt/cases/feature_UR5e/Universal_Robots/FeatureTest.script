  blend_radius_m = 0.000
  speed_ms    = 0.300
  movel(pose_trans(ref_frame,p[-0.384494, 0.350433, 0.368074, 3.036811, 0.389568, 0.461664]),accel_mss,speed_ms,0,0.000)
  set_standard_digital_out(3, True)
  DO_GRIP = 0
  while (get_standard_digital_in(5) != True):
    sync()
  end
  while (DI_PART != True):
