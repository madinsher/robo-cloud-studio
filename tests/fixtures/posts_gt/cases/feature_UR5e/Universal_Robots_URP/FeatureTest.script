  movel(p[-0.441769, 0.044852, 0.400392, -2.784047, -1.253997, -0.442003],accel_mss,speed_ms,0,0.005)
  # Circular move (R55.6 mm)
  movec(p[-0.408198, 0.061237, 0.388074, -2.843025, -1.166595, -0.465806],p[-0.414384, 0.147916, 0.407797, -2.938632, -0.908861, -0.436254],1.50000,0.30000,0.0050)
  speed_ms    = 0.0500
  blend_radius_m = 0.0000
  movel(p[-0.441769, 0.044852, 0.400392, -2.784047, -1.253997, -0.442003],accel_mss,speed_ms,0,0.000)
  blend_radius_m = 0.0000
  speed_ms    = 0.3000
  movel(p[-0.408198, 0.061237, 0.388074, -2.843025, -1.166595, -0.465806],accel_mss,speed_ms,0,0.000)
  set_standard_digital_out(3, True)
  DO_GRIP = False
  while (get_standard_digital_in(5) != True):
    sync()
  end
  while (DI_PART != True):
    sync()
  end
  sleep(0.500)
  # a comment line
