$ACC.CP = 1.50000
$ACC.ORI1 = 400.00000
$ACC.ORI2 = 400.00000
$APO.CPTP = 5
$APO.CDIS = 5.000
PTP {A1 10.00000,A2 -80.00000,A3 100.00000,A4 20.00000,A5 40.00000,A6 -30.00000} C_PTP
LIN {X 549.094,Y 5.962,Z 504.960,A -174.431,B 15.001,C 175.695} C_DIS
CIRC {X 506.272,Y -26.320,Z 503.226,A -178.509,B 14.048,C 175.384},{X 507.783,Y -138.190,Z 515.247,A 171.653,B 15.955,C 176.009} C_DIS
