&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF All_Events_1 ( )


; GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
; INTERRUPT ON 3

;FOLD Initialise and set default speed
BAS (#INITMOV,0)
BAS (#VEL_PTP,100)
BAS (#ACC_PTP,20)
$VEL.CP=0.2
BAS (#TOOL,0)
BAS (#BASE,0)
;ENDFOLD

;;FOLD STARTPOS
;$BWDSTART = FALSE
;PDAT_ACT = PDEFAULT
;BAS(#PTP_DAT)
;FDAT_ACT = {TOOL_NO 0,BASE_NO 0,IPO_FRAME #BASE}
;BAS(#FRAMES)
;;ENDFOLD

$ADVANCE = 5

;FOLD ---- Quickly skip BCO ----
; PTP $AXIS_ACT
;ENDFOLD

;FOLD ---- GO HOME ----
; PTP {A1 0.000, A2 -90.000, A3 90.000, A4 0.000, A5 0.000, A6 0.000, E1 0, E2 0, E3 0, E4 0, E5 0, E6 0}
;ENDFOLD


; Program generated by VerticalBot Studio for Universal Robots UR10e on 25/10/2026 12:00:00
; Using nominal kinematics.
; start
; ---- Setting reference (Base) ----
$BASE = {FRAME: X 500.000,Y 0.000,Z 0.000,A 0.000,B 0.000,C 0.000}
; --------------------------
; ---- Setting tool (TCP) ----
$TOOL = {FRAME: X 0.000,Y 0.000,Z 120.000,A 0.000,B 0.000,C 0.000}
; --------------------------
$VEL.CP = 0.25000
$VEL.ORI1 = 60.00000
$VEL.ORI2 = 60.00000
$ACC.CP = 1.20000
$ACC.ORI1 = 300.00000
$ACC.ORI2 = 300.00000
$VEL.ORI1 = 30.00000
$VEL.ORI2 = 30.00000
$APO.CPTP = 10
$APO.CDIS = 10.000
PTP {A1 10.00000,A2 -90.00000,A3 90.00000,A4 -90.00000,A5 -90.00000,A6 0.00000} C_PTP
$VEL.CP = 0.10000
LIN {X 300.000,Y 100.000,Z 200.000,A 0.000,B 0.000,C 180.000} C_DIS
$VEL.CP = 0.25000
CIRC {X 350.000,Y 150.000,Z 200.000,A 0.000,B 0.000,C 180.000},{X 400.000,Y 100.000,Z 200.000,A 0.000,B 0.000,C 180.000} C_DIS
$APO.CPTP = 0
$APO.CDIS = 0.000
LIN {X 400.000,Y -100.000,Z 300.000,A 0.000,B 0.000,C 180.000} C_DIS
WAIT SEC 0.500
HALT
DO3=TRUE
gripper=FALSE
START_TIMER:
$TIMER_STOP[1]=TRUE
$TIMER_FLAG[1]=FALSE
$TIMER[1]=2.000
$TIMER_STOP[1]=FALSE
WAIT FOR (DI7==FALSE OR $TIMER_FLAG[1])
$TIMER_STOP[1]=TRUE
IF $TIMER_FLAG[1]== TRUE THEN
    HALT ; Timed out!
    GOTO START_TIMER
ENDIF
MyRoutine()
x = 1
Wait for StrClear($LOOP_MSG[])
$LOOP_CONT = TRUE
$LOOP_MSG[] = "Cycle "done""
Sub_Routine()
; gripper close
; gripper open
; NAVIGATE X 1500.000 Y -200.000
; TASK harvest
PTP {A1 0.00000,A2 -90.00000,A3 90.00000,A4 -90.00000,A5 -90.00000,A6 0.00000} C_PTP
END
