/MN
   1:  ! Program generated by VerticalBot Studio for Universal Robots ;
   2:  ! UR10e on 25/10/2026 12:00:00 ;
   3:  ! Using nominal kinematics. ;
   4:  ! start ;
   5:  PR[9,1]=500.000 ;
   6:  PR[9,2]=0.000 ;
   7:  PR[9,3]=0.000 ;
   8:  PR[9,4]=0.000 ;
   9:  PR[9,5]=0.000 ;
  10:  PR[9,6]=0.000 ;
