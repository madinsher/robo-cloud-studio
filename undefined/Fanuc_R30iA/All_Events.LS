  12:  UFRAME_NUM=9 ;
  13:  PR[9,1]=0.000 ;
  14:  PR[9,2]=0.000 ;
  15:  PR[9,3]=120.000 ;
  16:  PR[9,4]=0.000 ;
  17:  PR[9,5]=0.000 ;
  18:  PR[9,6]=0.000 ;
  19:  UTOOL[9]=PR[9] ;
  20:  UTOOL_NUM=9 ;
  21:J P[1] 15% CNT10 ACC100 ;
  22:L P[2] 100mm/sec CNT10 ACC100 ;
  23:C P[3] 
       P[4] 250mm/sec CNT10 ;
  24:L P[5] 250mm/sec CNT0 ACC100 ;
  25:  WAIT  0.50(sec) ;
  26:  PAUSE ;
  27:  DO3=ON ;
  28:  gripper=OFF ;
  29:  $WAITTMOUT=2000 ;
  30:  WAIT DI7=OFF TIMEOUT, LBL[1] ;
