  32:  PAUSE ;
  33:  LBL[1] ;
  34:  CALL MyRoutine ;
  35:  x = 1;
  36:  MESSAGE[Cycle "done"] ;
  37:  CALL Sub_Routin ;
  38:  ! gripper close ;
  39:  ! gripper open ;
  40:  ! NAVIGATE X 1500.000 Y -200.000 ;
  41:  ! TASK harvest ;
  42:J P[6] 5% CNT0 ACC100 ;
/POS
P[1]{
